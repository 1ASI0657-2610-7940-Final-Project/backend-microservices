{
    "version":  "0.2.0",
    "configurations":  [
                           {
                               "type":  "java",
                               "name":  "AccessProfileService local",
                               "request":  "launch",
                               "cwd":  "${workspaceFolder}/services/access-profile-service",
                               "mainClass":  "com.gigu.accessprofile.AccessProfileServiceApplication",
                               "projectName":  "access-profile-service",
                               "envFile":  "${workspaceFolder}/.env",
                               "env":  {
                                           "SPRING_PROFILES_ACTIVE":  "local",
                                           "SPRING_DATASOURCE_URL":  "${env:SUPABASE_JDBC_URL}",
                                           "SPRING_DATASOURCE_USERNAME":  "${env:SUPABASE_DB_USERNAME}",
                                           "SPRING_DATASOURCE_PASSWORD":  "${env:SUPABASE_DB_PASSWORD}"
                                       },
                               "vmArgs":  "-Dspring.profiles.active=local -Dcom.sun.management.jmxremote"
                           },
                           {
